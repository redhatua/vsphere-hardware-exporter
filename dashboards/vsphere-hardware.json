{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus / VictoriaMetrics datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "vSphere hardware inventory",
  "uid": "vsphere-hardware-inventory",
  "tags": [
    "vsphere",
    "inventory"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "vcenter",
        "label": "vCenter",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uuid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vsphere_host_hw_info, vcenter)",
          "refId": "v"
        },
        "definition": "label_values(vsphere_host_hw_info, vcenter)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "datacenter",
        "label": "Datacenter",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uuid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vsphere_host_hw_info{vcenter=~\"$vcenter\"}, datacenter)",
          "refId": "v"
        },
        "definition": "label_values(vsphere_host_hw_info{vcenter=~\"$vcenter\"}, datacenter)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uuid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vsphere_host_hw_info{vcenter=~\"$vcenter\",datacenter=~\"$datacenter\"}, cluster)",
          "refId": "v"
        },
        "definition": "label_values(vsphere_host_hw_info{vcenter=~\"$vcenter\",datacenter=~\"$datacenter\"}, cluster)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uuid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vsphere_host_hw_info{vcenter=~\"$vcenter\",datacenter=~\"$datacenter\",cluster=~\"$cluster\"}, host)",
          "refId": "v"
        },
        "definition": "label_values(vsphere_host_hw_info{vcenter=~\"$vcenter\",datacenter=~\"$datacenter\",cluster=~\"$cluster\"}, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "stat",
      "title": "Hosts",
      "datasource": {
        "type": "prometheus",
        "uuid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uuid": "${DS_PROMETHEUS}"
          },
          "expr": "count(vsphere_host_hw_info{vcenter=~\"$vcenter\",datacenter=~\"$datacenter\",cluster=~\"$cluster\",host=~\"$host\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "CPU cores",
      "datasource": {
        "type": "prometheus",
        "uuid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uuid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(vsphere_host_cpu_cores{vcenter=~\"$vcenter\",datacenter=~\"$datacenter\",cluster=~\"$cluster\",host=~\"$host\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Memory",
