        "type": "prometheus",
        "uuid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uuid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(vsphere_host_memory_bytes{vcenter=~\"$vcenter\",datacenter=~\"$datacenter\",cluster=~\"$cluster\",host=~\"$host\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Exporter up (all vCenters)",
      "datasource": {
        "type": "prometheus",
        "uuid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uuid": "${DS_PROMETHEUS}"
          },
          "expr": "min(vsphere_hw_exporter_up)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
