        {
          "datasource": {
            "type": "prometheus",
            "uuid": "${DS_PROMETHEUS}"
          },
          "expr": "vsphere_host_cpu_cores{vcenter=~\"$vcenter\",datacenter=~\"$datacenter\",cluster=~\"$cluster\",host=~\"$host\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uuid": "${DS_PROMETHEUS}"
          },
          "expr": "vsphere_host_cpu_threads{vcenter=~\"$vcenter\",datacenter=~\"$datacenter\",cluster=~\"$cluster\",host=~\"$host\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uuid": "${DS_PROMETHEUS}"
          },
          "expr": "vsphere_host_memory_bytes{vcenter=~\"$vcenter\",datacenter=~\"$datacenter\",cluster=~\"$cluster\",host=~\"$host\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uuid": "${DS_PROMETHEUS}"
          },
          "expr": "vsphere_host_in_maintenance_mode{vcenter=~\"$vcenter\",datacenter=~\"$datacenter\",cluster=~\"$cluster\",host=~\"$host\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "F"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "Value #A": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "vcenter": "vCenter",
              "datacenter": "Datacenter",
              "cluster": "Cluster",
              "host": "Host",
              "vendor": "Vendor",
              "model": "Model",
              "bios_version": "BIOS",
              "bios_date": "BIOS date",
              "cpu_model": "CPU",
              "esxi_version": "ESXi",
              "esxi_build": "Build",
              "Value #B": "Sockets",
              "Value #C": "Cores",
              "Value #D": "Threads",
              "Value #E": "Memory",
              "Value #F": "Maintenance"
            },
            "indexByName": {
              "host": 0,
              "cluster": 1,
              "datacenter": 2,
              "vcenter": 3,
              "vendor": 4,
              "model": 5,
              "cpu_model": 6,
              "Value #B": 7,
              "Value #C": 8,
              "Value #D": 9,
              "Value #E": 10,
              "esxi_version": 11,
              "esxi_build": 12,
              "bios_version": 13,
              "bios_date": 14,
              "Value #F": 15
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #E"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #F"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "no"
                      },
                      "1": {
                        "text": "yes",
                        "color": "orange"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Host",
            "desc": false
          }
        ],
        "footer": {
          "show": false
        }
      }
    },
