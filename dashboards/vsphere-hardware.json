          "datasource": {
            "type": "prometheus",
            "uuid": "${DS_PROMETHEUS}"
          },
          "expr": "vsphere_host_cpu_sockets{vcenter=~\"$vcenter\",datacenter=~\"$datacenter\",cluster=~\"$cluster\",host=~\"$host\"}",
