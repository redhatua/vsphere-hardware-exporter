    {
      "id": 1,
      "type": "table",
      "title": "Host hardware",
      "datasource": {
        "type": "prometheus",
        "uuid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uuid": "${DS_PROMETHEUS}"
          },
          "expr": "vsphere_host_hw_info{vcenter=~\"$vcenter\",datacenter=~\"$datacenter\",cluster=~\"$cluster\",host=~\"$host\"}",
